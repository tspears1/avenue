{
   "name": "ave-ui",
   "version": "0.0.1",
   "type": "module",
   "exports": {
      ".": "./dist/index.js",
      "./all": "./dist/index.js",
      "./loader": "./dist/loader.js",
      "./components/*": "./dist/components/*/*.lit.js"
   },
   "scripts": {
      "dev": "vite",
      "build": "npm run build:registry && tsc && vite build",
      "build:registry": "node bin/build-registry.js",
      "watch": "tsc && vite build --watch",
      "preview": "vite preview",
      "storybook": "storybook dev -p 6006",
      "build-storybook": "storybook build",
      "create:component": "node bin/create-component.js"
   },
   "peerDependencies": {
      "lit": "^3.3.2"
   },
   "dependencies": {
      "ave-cli": "workspace:*",
      "ave-css": "workspace:*"
   },
   "devDependencies": {
      "@chromatic-com/storybook": "^5.2.1",
      "@storybook/addon-a11y": "^10.5.0",
      "@storybook/addon-docs": "^10.5.0",
      "@storybook/addon-vitest": "^10.5.0",
      "@storybook/web-components-vite": "^10.5.0",
      "@vitest/browser-playwright": "^4.1.8",
      "@vitest/coverage-v8": "^4.1.8",
      "lit": "^3.3.2",
      "playwright": "^1.60.0",
      "storybook": "^10.5.0",
      "typescript": "~6.0.2",
      "vite": "^8.0.12",
      "vitest": "^4.1.8"
   }
}