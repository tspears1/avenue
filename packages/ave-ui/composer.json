{
    "name": "bostonuniversity/ave-ui",
    "description": "Web components library built with Lit for WordPress integration - PHP/Twig templates",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ave-acf",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.0",
        "bostonuniversity/ave-acf": "dev-main",
        "timber/timber": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AvenueUI\\": "src/"
        },
        "files": [
            "src/wordpress/index.php"
        ]
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}