{
    "name": "bostonuniversity/ave-ui",
    "description": "Web components library built with Lit for WordPress integration - PHP/Twig templates",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ave-acf",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.0",
        "bostonuniversity/ave-acf": "dev-main",
        "timber/timber": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AvenueUI\\": "src/"
        },
        "classmap": [
            "src/components"
        ],
        "files": [
            "src/WordPress/index.php"
        ]
    },
    "scripts": {
        "test:adapters": "php tests/php/value-adapters.php",
        "test:acf-validation": "php tests/php/acf-required-validation.php",
        "test:admin-assets": "php tests/php/admin-page-assets.php",
        "test:schema": "php tests/php/component-schema.php",
        "test:transport": "php tests/php/component-transport.php",
        "test:php": [
            "@test:adapters",
            "@test:acf-validation",
            "@test:admin-assets",
            "@test:schema",
            "@test:transport"
        ]
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
