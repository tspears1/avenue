{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],

        /* Bundler mode */
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting */
        "erasableSyntaxOnly": true,
    },
    "include": [
        "src",
        "src/**/*.ts",
        "src/types/**/*.d.ts"
    ],
}
