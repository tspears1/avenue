{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component-manifest.schema.json",
   "name": "section",
   "displayName": "Section",
   "description": "Section component",
   "version": "1.0.0",
   "tag": "ave-section",
   "schema": "./section.schema.json",
   "docs": {
      "storybook": "http://localhost:6006/?path=/docs/organisms-section--docs"
   },
   "exports": {
