{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component.schema.json",
   "$id": "https://github.com/bostonuniversity/avenue/packages/ave-ui/src/components/section/section.schema.json",
   "title": "Section",
   "type": "component",
   "props": {
      "root": {
         "elementId": {
            "type": "string"
         },
         "appearance": {
            "type": "string",
            "enum": [
               "light",
               "dark"
            ],
            "default": "light"
         },
         "additionalClasses": {
            "type": "string"
         },
         "header": {
            "type": "object",
            "attribute": false,
            "transport": "property",
            "properties": {
               "heading": {
                  "type": "string"
               },
               "intro": {
                  "type": "string"
               },
               "buttons": {
                  "type": "array",
                  "items": {
                     "type": "object",
                     "contract": {
                        "component": "button"
                     }
                  }
               }
            }
         },
         "footer": {
            "type": "object",
            "attribute": false,
            "transport": "property",
            "properties": {
               "heading": {
                  "type": "string"
               },
               "outro": {
                  "type": "string"
               },
               "buttons": {
                  "type": "array",
                  "items": {
                     "type": "object",
                     "contract": {
                        "component": "button"
                     }
                  }
               }
            }
         }
      }
   },
   "attributes": {
      "root": {
         "allowGlobal": true,
         "allowData": true,
         "allowAria": true
      }
   },
   "slots": {
      "root": {
         "default": {
            "allowed": [
               "html"
            ],
            "optional": true
         }
      }
   },
   "classes": {
      "root": {
         "allow": true
      }
   }
}
