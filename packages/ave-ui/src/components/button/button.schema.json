{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component.schema.json",
   "$id": "https://github.com/bostonuniversity/avenue/packages/ave-ui/src/components/button/button.schema.json",
   "title": "Button",
   "type": "component",
   "props": {
      "root": {
         "label": {
            "type": "string",
            "required": true
         },
         "variant": {
            "type": "string",
            "enum": [
               "primary",
               "secondary",
               "outline"
            ],
            "default": "primary"
         },
         "href": {
            "type": "string"
         },
         "target": {
            "type": "string",
            "enum": [
               "_self",
               "_blank",
               "_parent",
               "_top"
            ],
            "default": "_self"
         },
         "icon": {
            "type": "string"
         }
      }
   },
   "attributes": {
      "root": {
         "allowGlobal": true,
         "allowData": true,
         "allowAria": true
      }
   },
   "slots": {
      "root": {
         "prefix": {
            "allowed": [
               "html"
            ],
            "optional": true
         },
         "suffix": {
            "allowed": [
               "html"
            ],
            "optional": true
         }
      }
   },
   "classes": {
      "root": {
         "allow": true
      }
   }
}
