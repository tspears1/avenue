{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component-manifest.schema.json",
   "name": "button",
   "displayName": "Button",
   "description": "Interactive button component with multiple theme variants",
   "version": "1.0.0",
   "tag": "ave-button",
   "schema": "./button.schema.json",
   "docs": {
      "storybook": "http://localhost:6006/?path=/docs/atoms-button--docs"
   },
   "exports": {
      "php": [
         "button.class.php"
      ]
   },
   "integrations": {
      "wordpress": {
         "acfFields": {
            "supported": true,
            "file": "button.acf.php",
            "groupKey": "group_button_component",
            "dependencies": []
         },
         "acfBlock": {
            "file": "button.block.php",
            "name": "avenue/button",
            "supported": true
         }
      }
   }
}