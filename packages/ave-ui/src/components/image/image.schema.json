{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component.schema.json",
   "$id": "https://github.com/bostonuniversity/avenue/packages/ave-ui/src/components/image/image.schema.json",
   "title": "Image",
   "type": "component",
   "props": {
      "root": {
         "src": {
            "type": "string",
            "required": true
         },
         "alt": {
            "type": "string",
            "default": ""
         },
         "srcset": {
            "type": "string"
         },
         "sizes": {
            "type": "string"
         },
         "height": {
            "type": "string"
         },
         "width": {
            "type": "string"
         },
         "sources": {
            "type": "array",
            "attribute": false,
            "transport": "property",
            "items": {
               "type": "object",
               "properties": {
                  "src": {
                     "type": "string",
                     "required": true
                  },
                  "type": {
                     "type": "string"
                  },
                  "media": {
                     "type": "string"
                  },
                  "sizes": {
                     "type": "string"
                  }
               }
            }
         },
         "objectFit": {
            "type": "string",
            "attribute": "object-fit",
            "default": "cover"
         },
         "objectPosition": {
            "type": "string",
            "attribute": "object-position",
            "default": "center"
         }
      }
   },
   "attributes": {
      "root": {
         "allowGlobal": true,
         "allowData": true,
         "allowAria": true
      }
   },
   "slots": {
      "root": {
         "default": {
            "allowed": [
               "html"
            ],
            "optional": true
         }
      }
   },
   "classes": {
      "root": {
         "allow": true
      }
   }
}
