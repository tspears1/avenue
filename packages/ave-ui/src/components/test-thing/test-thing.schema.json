{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component.schema.json",
   "$id": "https://github.com/bostonuniversity/avenue/packages/ave-ui/src/components/test-thing/test-thing.schema.json",
   "title": "Test Thing",
   "type": "component",
   "props": {
      "root": {
         "label": {
            "type": "string",
            "required": true
         }
      }
   },
   "attributes": {
      "root": {
         "allowGlobal": true,
         "allowData": true,
         "allowAria": true
      }
   },
   "slots": {
      "root": {
         "default": {
            "allowed": [
               "html"
            ],
            "optional": true
         }
      }
   },
   "classes": {
      "root": {
         "allow": true
      }
   }
}
