{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component-manifest.schema.json",
   "name": "card",
   "displayName": "Card",
   "description": "Interactive card component with multiple theme variants",
   "version": "1.0.0",
   "tag": "ave-card",
   "schema": "./card.schema.json",
   "exports": {
      "php": [
         "card.class.php"
      ],
      "acf": [
         "card.acf.php"
      ]
   },
   "integrations": {
      "wordpress": {
         "acfFields": {
            "supported": true,
            "groupKey": "group_card_component",
            "dependencies": [
               "button"
            ]
         },
         "acfBlock": {
            "supported": true,
            "name": "avenue/card",
            "file": "card.block.php"
         }
      }
   }
}