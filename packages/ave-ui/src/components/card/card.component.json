{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component-manifest.schema.json",
   "name": "card",
   "displayName": "Card",
   "description": "Card component",
   "version": "1.0.0",
   "tag": "ave-card",
   "schema": "./card.schema.json",
   "docs": {
      "storybook": "http://localhost:6006/?path=/docs/molecules-card--docs"
   },
   "exports": {
      "php": [
         "card.class.php"
      ],
      "acf": [
         "card.acf.php"
      ]
   },
   "integrations": {
      "wordpress": {
         "acfFields": {
            "supported": true,
            "file": "card.acf.php",
            "groupKey": "group_card_component",
            "dependencies": [
               "button",
               "image"
            ]
         },
         "acfBlock": {
            "supported": true,
            "file": "card.block.php",
            "name": "avenue/card"
         }
      }
   }
}
