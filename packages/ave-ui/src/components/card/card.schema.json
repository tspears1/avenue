{
   "$schema": "https://github.com/bostonuniversity/avenue/schemas/component.schema.json",
   "$id": "https://github.com/bostonuniversity/avenue/packages/ave-ui/src/components/card/card.schema.json",
   "title": "Card",
   "type": "component",
   "props": {
      "root": {
         "title": {
            "type": "string",
            "required": true
         },
         "text": {
            "type": "string"
         },
         "link": {
            "type": "object",
            "attribute": false,
            "transport": "property",
            "contract": {
               "component": "button",
               "overrides": {
                  "label": {
                     "required": false,
                     "default": "Learn More",
                     "defaultOnEmpty": true
                  }
               }
            }
         },
         "image": {
            "type": "object",
            "attribute": false,
            "transport": "property",
            "contract": {
               "component": "image"
            }
         }
      }
   },
   "attributes": {
      "root": {
         "allowGlobal": true,
         "allowData": true,
         "allowAria": true
      }
   },
   "slots": {
      "root": {
         "default": {
            "allowed": [
               "html"
            ],
            "optional": true
         }
      }
   },
   "classes": {
      "root": {
         "allow": true
      }
   }
}
