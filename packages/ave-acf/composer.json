{
   "name": "bostonuniversity/ave-acf",
   "description": "Reusable ACF helpers for Avenue projects.",
   "type": "library",
   "license": "MIT",
   "require": {
      "php": ">=8.0"
   },
   "autoload": {
      "psr-4": {
         "Avenue\\ACF\\": "src/"
      }
   },
   "scripts": {
      "test:field-builder": "php tests/php/field-builder.php",
      "test:php": [
         "@test:field-builder"
      ]
   },
   "minimum-stability": "stable",
   "prefer-stable": true
}
