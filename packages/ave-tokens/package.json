
{
  "name": "ave-tokens",
  "version": "0.0.1",
  "description": "Source design tokens and platform transformers for Avenue.",
  "type": "module",
  "bin": {
    "ave-tokens": "./bin/build-figma.js",
    "ave-tokens-source": "./bin/compile-tokens.js"
  },
  "exports": {
    "./tokens": "./tokens.json",
    "./rules": "./src/rules/index.js",
    "./source-compiler": "./src/source-compiler.js",
    "./figma-transformer": "./src/figma-transformer.js"
  },
  "files": [
    "dist",
    "schemas",
    "src",
    "tokens",
    "tokens.json"
  ],
  "scripts": {
    "build": "pnpm run build:source && pnpm run build:figma",
    "build:source": "node ./bin/compile-tokens.js",
    "build:figma": "node ./bin/build-figma.js",
    "check": "pnpm run check:source && pnpm run check:figma",
    "check:source": "node ./bin/compile-tokens.js --check",
    "check:figma": "node ./bin/build-figma.js --check",
    "test": "node --test ./tests/*.test.js"
  },
  "dependencies": {
    "ave-cli": "workspace:*",
    "culori": "^4.0.2",
    "yaml": "^2.9.0"
  }
}
